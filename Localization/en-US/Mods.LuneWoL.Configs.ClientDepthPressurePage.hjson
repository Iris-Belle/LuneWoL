Tooltip: ""

Headers: {
	Performance: Performance
	Debug: Debug
}

UpdateIntervalTicks: {
	Label: Update Interval Ticks
	Tooltip:
		'''
		The amount of ticks between each floodfill.
		-----------------------------------
		Maximum recommended is `2` ticks.
		-----------------------------------
		Recommended is `0` if your cpu can afford it
		-----------------------------------
		Requested by `Iris`
		'''
}

TileScanLimit: {
	Label: Max Tile Scans Per Tick
	Tooltip:
		'''
		The maximum amount of tiles scanned for each tick to find the surface.
		-----------------------------------
		Minimum recommended is 64 tiles.
		-----------------------------------
		Recommended is `-1` and means no limit.
		-----------------------------------
		Requested by `Iris`
		'''
}

ShowDebugMarker: {
	Label: Show Debug Marker
	Tooltip: Shows you where the surface level of the water body you're in is.
}

ShowScannedDebug: {
	Label: Show Scanned Debug
	Tooltip: Shows all tiles the pressure system has scanned.
}

DebugText: {
	Label: Debug Text
	Tooltip: Shows data about the calculations for the pressure system.
}

ShowDebugMarkerColour: {
	Label: Debug Marker Colour
	Tooltip: ""
}

ShowScannedDebugColour: {
	Label: Scanned Debug Colour
	Tooltip: ""
}
