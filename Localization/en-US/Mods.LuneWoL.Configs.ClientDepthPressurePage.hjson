Tooltip: ""

Headers: {
	Performance: Performance
	Debug: Debug
}

UpdateIntervalTicks: {
	Label: Update Interval Ticks
	Tooltip:
		'''
		(Mode 2) The amount of ticks between each floodfill.
		-----------------------------------
		Maximum recommended is `2` ticks.
		-----------------------------------
		Recommended is `1`
		Only use `0` if you dont get stuttering when entering water bodies.
		-----------------------------------
		Requested by `Iris`
		'''
}

TileScanLimit: {
	Label: Max Tile Scans Per Tick
	Tooltip:
		'''
		(Mode 2) The maximum amount of tiles scanned for each tick to find the surface.
		-----------------------------------
		Minimum recommended is 64 tiles.
		-----------------------------------
		Recommended is `512`
		Only use `-1` if you dont get stuttering when entering water bodies.
		-----------------------------------
		Requested by `Iris`
		'''
}

ShowDebugMarker: {
	Label: Show Debug Marker
	Tooltip: Shows you where the system thinks the surface level of the water body you're in is.
}

ShowScannedDebug: {
	Label: Show Scanned Debug
	Tooltip: (Mode 2) Shows all tiles the pressure system has scanned.
}

DebugText: {
	Label: Debug Text
	Tooltip: Shows data about the calculations for the pressure system.
}

ShowDebugMarkerColour: {
	Label: Debug Marker Colour
	Tooltip: ""
}

ShowScannedDebugColour: {
	Label: Scanned Debug Colour
	Tooltip: ""
}

MurkyWaterUpdateTicks: {
	Label: Murky Water Update Ticks
	Tooltip: ""
}
