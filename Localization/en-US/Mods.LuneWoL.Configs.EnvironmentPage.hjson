Tooltip: ""

Headers: {
	bool: bool
	I4: I4
}

DarkerNightsMode: {
	Label: Darker Nights Mode
	Tooltip:
		'''
		Makes nights darker. (real shocker, i know)
		-----------------------------------
		0: Disabled
		1: Allows the moon to change the brightness at night
		2: Always pitch black at night
		3: Always night (not literally, just visually)
		-----------------------------------
		Has Advanced Settings
		-----------------------------------
		Requested by `Iris`
		'''
}

DepthPressureMode: {
	Label: Depth Pressure Mode
	Tooltip:
		'''
		The deeper you are in a water body, the faster you lose breath + some extra stuff.

		Changes how the surface of a water body is found.
		-----------------------------------
		0: Off
		1: Fast but can be inaccurate
		2: Accurate but slightly more intensive on the CPU.
		-----------------------------------
		Has Advanced Settings + Client Settings
		-----------------------------------
		Requested by `Iris`
		'''
}

EvilBiomeDoT: {
	Label: Evil Biome DoT
	Tooltip:
		'''
		Makes evil biomes (Crimson and Corruption) inflict DoT.
		-----------------------------------
		Requested by `Iris`
		'''
}

MurkyWater: {
	Label: Murkier Water
	Tooltip:
		'''
		Changes light decay in water.
		-----------------------------------
		Has Advanced Settings
		-----------------------------------
		Requested by `Iris`
		'''
}

OreDropChance: {
	Label: Ore Drop Chance
	Tooltip:
		'''
		Makes ores have a chance to not drop when mined.
		-----------------------------------
		Has Advanced Settings
		-----------------------------------
		Requested by `Mushy`
		'''
}

OreScarcityPatchToggle: {
	Label: Ore Scarcity Patch Toggle
	Tooltip:
		'''
		Decreases the amount of ore that generates during world generation and on altar destruction.
		This is only a toggle to let the IL patch load.
		-----------------------------------
		Has Advanced Settings
		-----------------------------------
		Requested by `ClayWarTheOne`
		'''
}

