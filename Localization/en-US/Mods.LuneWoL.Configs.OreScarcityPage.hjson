Tooltip: ""

PrehardmodeOreScarcityPercent: {
	Label: Pre-Hardmode Ore Density
	Tooltip:
		'''
		This controls how many veins there will be.
		-----------------------------------
		A value of `50` would mean there's half as many veins in the world compared to vanilla.
		-----------------------------------
		Set to `100` to disable.
		-----------------------------------
		Requested by `ClayWarTheOne`
		'''
}

PrehardmodeOreAmountPercent: {
	Label: Pre-Hardmode Ore Amount
	Tooltip:
		'''
		This controls how large the veins will be.
		-----------------------------------
		A value of `50` would mean it generates veins with half the vanilla size.
		-----------------------------------
		Set to `100` to disable.
		-----------------------------------
		Requested by `ClayWarTheOne`
		'''
}

HardmodeOreScarcityPercent: {
	Label: Hardmode Ore Density Percent
	Tooltip:
		'''
		This controls how many veins will generate when an evil altar is destroyed.
		-----------------------------------
		A value of `50` would mean it generates half as many veins.
		-----------------------------------
		Set to `100` to disable.
		-----------------------------------
		Requested by `ClayWarTheOne`
		'''
}

