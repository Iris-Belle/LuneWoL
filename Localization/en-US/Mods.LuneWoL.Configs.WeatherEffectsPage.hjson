Tooltip: ""

TimeUntilApplyFrozen: {
	Label: Time Until `Frozen` Is Applied
	Tooltip:
		'''
		Determines how long it should take until the debuff is applied while youre in the right conditions.
		-----------------------------------
		Requested by `Iris`
		'''
}

BlizzardAppliesFrozenTime: {
	Label: Blizzard Applies `Frozen` Time
	Tooltip:
		'''
		How long this debuff should last in terraria ticks. (usually 60T/s)
		-----------------------------------
		Set to `0` to disable.
		-----------------------------------
		Requested by `Iris`
		'''
}

DisplayBlizzardAppliesFrozenTime: {
	Label: Display Blizzard Applies `Frozen` Time
	Tooltip:
		'''
		Whether the debuff should show how long is left until the debuff expires.
		-----------------------------------
		Requested by `Iris`
		'''
}

BlizzardFrozenDamage: {
	Label: Blizzard `Frozen` Damage
	Tooltip:
		'''
		Determines how much HP/s the `Frozen` debuff should inflict.
		-----------------------------------
		Requested by `Iris`
		'''
}

